generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum HeroSlideTheme {
  BLUE
  BLACK
  LIGHT
}

enum MovementType {
  RESTOCK
  ADJUSTMENT
  RESERVED
  RELEASED
  SOLD
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())

  @@index([position])
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String
  description      String
  ingredients      String?
  directions       String?
  specifications   Json?
  priceKes         Int
  discountPriceKes Int?
  isFeatured       Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  isArchived       Boolean          @default(false)
  categoryId       String
  category         ProductCategory  @relation(fields: [categoryId], references: [id])
  collections      Collection[]
  images           ProductImage[]
  variants         ProductVariant[]
  inventory        Inventory?
  reviews          ProductReview[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([isFeatured, isBestSeller])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  priceKes  Int?
  sku       String? @unique

  @@index([productId])
}

model Inventory {
  id         String              @id @default(cuid())
  productId  String              @unique
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int                 @default(0)
  lowStockAt Int                 @default(5)
  movements  InventoryMovement[]
  updatedAt  DateTime            @updatedAt
}

model InventoryMovement {
  id          String       @id @default(cuid())
  inventoryId String
  inventory   Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        MovementType
  change      Int
  note        String?
  orderId     String?
  createdAt   DateTime     @default(now())

  @@index([inventoryId, createdAt])
}

model Customer {
  id        String          @id @default(cuid())
  fullName  String
  phone     String          @unique
  orders    Order[]
  reviews   ProductReview[]
  createdAt DateTime        @default(now())
}

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  county          String
  town            String
  address         String
  instructions    String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  status          OrderStatus   @default(PENDING)
  subtotalKes     Int
  discountKes     Int           @default(0)
  deliveryKes     Int?
  totalKes        Int
  discountCode    String?
  termsVersion    String?
  termsAcceptedAt DateTime?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  name         String
  unitPriceKes Int
  quantity     Int

  @@index([orderId])
}

model StoreSettings {
  id                  Int       @id @default(1)
  businessName        String
  logoUrl             String?
  whatsappNumber      String
  email               String?
  phone               String?
  location            String?
  businessHours       String?
  deliveryChargeKes   Int?
  announcement        String?
  currency            String    @default("KES")
  socials             Json?
  legalName           String?
  tradingName         String?
  registrationDetails String?
  physicalAddress     String?
  supportEmail        String?
  privacyEmail        String?
  deliveryAreas       String?
  deliveryEstimate    String?
  returnPeriod        String?
  refundTimeline      String?
  orderRetention      String?
  newsletterRetention String?
  reviewRetention     String?
  securityRetention   String?
  legalPolicyVersion  String?
  legalEffectiveDate  DateTime?
  updatedAt           DateTime  @updatedAt
}

model PromotionalBanner {
  id       String  @id @default(cuid())
  title    String
  subtitle String?
  imageUrl String?
  href     String?
  active   Boolean @default(true)
  position Int     @default(0)
}

model HeroSlide {
  id                 String         @id @default(cuid())
  position           Int            @default(0)
  theme              HeroSlideTheme @default(BLUE)
  backgroundImageUrl String?
  eyebrow            String
  headline           String
  primaryLabel       String
  primaryHref        String
  secondaryLabel     String
  secondaryHref      String
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([active, position])
}

model ProductReview {
  id               String    @id @default(cuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  rating           Int
  body             String
  verifiedPurchase Boolean   @default(false)
  approved         Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([productId, approved])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  consentVersion String?
  consentedAt    DateTime?
  createdAt      DateTime  @default(now())
}

model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Int
  active     Boolean   @default(true)
  expiresAt  DateTime?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  position Int    @default(0)
}
